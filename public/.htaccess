# Salao Moreno's - configuracao de producao (Apache / HostGator)

# ---------- Pagina inicial ----------
DirectoryIndex index.html

# ---------- HTTPS + dominio canonico (sem www) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forca HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Remove o www (o canonical do site aponta para salaomorenos.com.br)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ---------- Rota interna das avaliacoes do Google ----------
# O site e estatico; o unico codigo de servidor e este endpoint em PHP, que
# guarda a chave da Places API. URL limpa -> arquivo .php.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/google-reviews/?$ api/google-reviews.php [L]
</IfModule>

# config.php so e util quando incluido pelo endpoint; acesso direto, nunca.
<Files "config.php">
  Require all denied
</Files>

# Se o PHP estiver desligado nesta conta, um .php seria servido como texto.
# Esta linha garante que a pasta /api so entregue conteudo processado.
<IfModule !mod_php.c>
  <IfModule !proxy_fcgi_module>
    <FilesMatch "\.php$">
      Require all denied
    </FilesMatch>
  </IfModule>
</IfModule>

# ---------- Compressao ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# ---------- Cache ----------
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML sempre revalidado: uma publicacao nova aparece na hora
  ExpiresByType text/html                 "access plus 0 seconds"
  # Assets versionados pelo deploy: cache longo
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # vendor/ e biblioteca com versao fixa (react 18.3.1): nunca muda sob o mesmo
  # nome, entao pode ficar um ano no cache do visitante
  <FilesMatch "^react(-dom)?\.production\.min\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Seguranca basica
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
</IfModule>

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# ---------- Protecao ----------
# Bloqueia arquivos internos caso algum dia subam por engano.
#
# ATENCAO: *.dc.html NAO pode entrar nesta lista. Os componentes em /_dc/
# (SiteHeader, SiteFooter, PaginaMorenos) sao buscados pelo NAVEGADOR em tempo
# de execucao; bloqueados, o cabecalho e o rodape aparecem vazios e as 13
# paginas internas ficam sem corpo. Quem guarda o design de referencia e a
# pasta fonte/, que nunca e publicada.
<FilesMatch "^(\.htaccess|\.gitignore|\.cpanel\.yml|package\.json|.*\.(md|py|mjs|csv|yml|yaml)|\.env.*)$">
  Require all denied
</FilesMatch>

# Sem listagem de diretorio
Options -Indexes

ErrorDocument 404 /index.html
