# >>> homologacao: inserido pelo build, nao editar a mao >>>
# Ambiente de aprovacao. Nada daqui pode entrar no indice de busca.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
# <<< homologacao <<<

# Salao Moreno's - configuracao de producao (Apache / HostGator)

# ---------- Pagina inicial ----------
DirectoryIndex index.html

# ---------- HTTPS + dominio canonico (sem www) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forca HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Remove o www (o canonical do site aponta para salaomorenos.com.br)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Uma pagina, um endereco. /servicos/index.html servia a mesma pagina que
  # /servicos/ e respondia 200 nas duas: duas URLs para o mesmo conteudo, e o
  # canonical de uma delas apontando para a outra. Agora o /index.html manda
  # para a forma com barra, de uma vez.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]
</IfModule>

# Pasta sem barra final (/servicos) redireciona para /servicos/ em vez de
# servir a pagina nos dois enderecos. E o padrao do Apache; fica explicito
# porque o site depende disso para nao duplicar URL.
<IfModule mod_dir.c>
  DirectorySlash On
</IfModule>

# ---------- Rota interna das avaliacoes do Google ----------
# O site e estatico; o unico codigo de servidor e este endpoint em PHP, que
# guarda a chave da Places API. URL limpa -> arquivo .php.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/google-reviews/?$ api/google-reviews.php [L]
</IfModule>

# config.php so e util quando incluido pelo endpoint; acesso direto, nunca.
<Files "config.php">
  Require all denied
</Files>

# Se o PHP estiver desligado nesta conta, um .php seria servido como texto.
# Esta linha garante que a pasta /api so entregue conteudo processado.
<IfModule !mod_php.c>
  <IfModule !proxy_fcgi_module>
    <FilesMatch "\.php$">
      Require all denied
    </FilesMatch>
  </IfModule>
</IfModule>

# ---------- Compressao ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# ---------- Cache ----------
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML sempre revalidado: uma publicacao nova aparece na hora
  ExpiresByType text/html                 "access plus 0 seconds"
  # Assets versionados pelo deploy: cache longo
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType video/webm                "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2|webm|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # vendor/ e biblioteca com versao fixa (react 18.3.1): nunca muda sob o mesmo
  # nome, entao pode ficar um ano no cache do visitante
  <FilesMatch "^react(-dom)?\.production\.min\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Seguranca basica
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
</IfModule>

# ---------- Componentes do runtime (/_dc/) ----------
# SiteHeader, SiteFooter e PaginaMorenos sao documentos HTML completos que o
# NAVEGADOR busca em tempo de execucao. Eles precisam continuar servidos (ja
# houve um 403 aqui que esvaziou o site inteiro), mas nao sao paginas: sem
# isto, respondem 200 e podem ser indexados como se fossem conteudo.
<IfModule mod_headers.c>
  <FilesMatch "\.dc\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType video/webm .webm
  AddType video/mp4 .mp4
</IfModule>

# ---------- Protecao ----------
# Bloqueia arquivos internos caso algum dia subam por engano.
#
# ATENCAO: *.dc.html NAO pode entrar nesta lista. Os componentes em /_dc/
# (SiteHeader, SiteFooter, PaginaMorenos) sao buscados pelo NAVEGADOR em tempo
# de execucao; bloqueados, o cabecalho e o rodape aparecem vazios e as 13
# paginas internas ficam sem corpo. Quem guarda o design de referencia e a
# pasta fonte/, que nunca e publicada.
<FilesMatch "^(\.htaccess|\.gitignore|\.cpanel\.yml|package\.json|.*\.(md|py|mjs|csv|yml|yaml)|\.env.*)$">
  Require all denied
</FilesMatch>

# Sem listagem de diretorio
Options -Indexes

# ---------- Pagina nao encontrada ----------
# Servia /index.html: qualquer URL errada devolvia a home inteira. O status ate
# era 404, mas o visitante via a home sem entender o que aconteceu, e o robo
# encontrava o conteudo da home em dezenas de enderecos diferentes. A pagina de
# erro propria ja existe e tem noindex.
ErrorDocument 404 /404.html
