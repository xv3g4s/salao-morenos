# Variaveis da integracao de avaliacoes do Google (Places API New).
#
# NAO commite valores reais. Em producao elas vivem no ambiente da hospedagem
# ou em ~/.morenos-env.php, fora do public_html — ver GOOGLE-REVIEWS-INTEGRATION.md.
#
# A chave e lida SO pelo servidor (public/api/google-reviews.php). Ela nunca
# aparece no HTML, no bundle, no navegador nem na resposta da rota interna.

GOOGLE_MAPS_API_KEY=

# Place ID de cada unidade. Descubra com:  npm run find:google-places
GOOGLE_PLACE_ID_CIDADE_CONTINENTAL=
GOOGLE_PLACE_ID_NOVO_HORIZONTE_AV_BRASIL=
GOOGLE_PLACE_ID_NOVO_HORIZONTE_AV_INDUSTRIAL=
